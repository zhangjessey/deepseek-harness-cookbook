{
  "name": "dsh-firewall-rule",
  "version": "0.1.0",
  "description": "dsh 组合包：基于能力 seam 的规则防火墙（RE2 引擎 + 控制面只读工具 + 数据面入口）。",
  "type": "module",
  "main": "lib/index.js",
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "scripts": {
    "build": "esbuild src/index.ts --bundle --format=esm --platform=node --packages=external --outfile=lib/index.js",
    "prepare": "esbuild src/index.ts --bundle --format=esm --platform=node --packages=external --outfile=lib/index.js"
  },
  "dependencies": {},
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-tools": "0.1.0-rc.8"
  },
  "devDependencies": {
    "esbuild": "^0.25.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
