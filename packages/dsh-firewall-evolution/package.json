{
  "name": "dsh-firewall-evolution",
  "version": "0.1.0",
  "description": "dsh 组合包：第20讲规则进化（增量读 nginx 日志、三类异常检测、脱敏、证据注入会话、长出候选）。",
  "type": "module",
  "main": "lib/index.js",
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "scripts": {
    "build": "esbuild src/index.ts --bundle --format=esm --platform=node --packages=external --outfile=lib/index.js",
    "prepare": "esbuild src/index.ts --bundle --format=esm --platform=node --packages=external --outfile=lib/index.js"
  },
  "dependencies": {},
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-tools": "0.1.0-rc.8",
    "@deepseek-ai/cordis-plugin-logger-console": "1.0.2",
    "@deepseek-ai/dsh-llm": "0.1.0-rc.8",
    "@deepseek-ai/dsh-llm-deepseek": "0.1.0-rc.8",
    "@deepseek-ai/dsh-anonymous-user-id": "0.1.0-rc.8"
  },
  "devDependencies": {
    "esbuild": "^0.25.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
