    "build:ch19-bundle": "cd packages/dsh-firewall-governance && esbuild src/index.ts --bundle --format=esm --platform=node --packages=external --outfile=lib/index.js",
    "build:ch20-bundle": "cd packages/dsh-firewall-evolution && esbuild src/index.ts --bundle --format=esm --platform=node --packages=external --outfile=lib/index.js",
